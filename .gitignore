# Python
__pycache__/
*.py[cod]
.venv/
venv/
.venv-codex/
.codex-python/
.codex-test-tmp/
*.egg-info/
dist/
build/

# Results & sim outputs
results/runs/**/*
!results/runs/.gitkeep
results/release/

# Data (keep fixtures dir, ignore captures)
data/fixtures/**/*.png
data/fixtures/**/*.jpg
!data/fixtures/**/.gitkeep
data/grasp_quality/images/
data/grasp_quality/manifest.json

# Hardware CAD binaries
hardware/cad/*
!hardware/cad/.gitkeep

# Media & weights
*.mp4
*.mov
*.zip
*.pt
*.onnx
*.safetensors
models/*.meta.json
!models/grasp_pickup_table_resnet18_siamese_224.pt
!docs/demo/*.mp4

# Stretch training artifacts
stretch/yolo/runs/
stretch/yolo/weights/
